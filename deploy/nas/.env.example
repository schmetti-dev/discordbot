# Discord Bot Token: https://discord.com/developers/applications -> App -> Bot -> Token
DISCORD_TOKEN=dein_token_hier

# Server-ID: Slash Commands sind dann sofort da statt nach bis zu einer Stunde.
DISCORD_GUILD_ID=deine_server_id_hier

# Rolle, die /buch-setzen ausführen darf
ADMIN_ROLE_NAME=Buchclub-Admin

# Wo die Datenbank auf dem Host liegt
DATA_DIR=./data

# Wohin die tägliche Sicherung geht. Am besten eine andere Platte oder Freigabe.
BACKUP_HOST_DIR=/pfad/zur/backup-freigabe/buchketiere

# Wie viele Sicherungen bleiben (eine pro Tag)
BACKUP_KEEP=14

# Zeitzone des Clubs: Erinnerungen gehen nur zwischen 9 und 20 Uhr raus.
TZ=Europe/Berlin

# Zusätzliche Gruppe für den Bot, falls die Backup-Freigabe nur einer Gruppe
# Schreibrechte gibt (auf dem NAS: `id` zeigt die Nummer, z.B. 10 für admin).
EXTRA_GID=1000
